<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Traditional IQ Test</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 20px;
    }
    h1 {
      text-align: center;
      color: #333;
    }
    .question {
      background: #fff;
      padding: 15px;
      margin-bottom: 10px;
      border-radius: 5px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    button {
      display: block;
      margin: 20px auto;
      padding: 10px 20px;
      font-size: 16px;
      background-color: #28a745;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    button:hover {
      background-color: #218838;
    }
    .result {
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <h1>Traditional IQ Test</h1>
  <div id="quiz">
    <!-- Question 1 -->
    <div class="question">
      <p>1. What number comes next in the sequence? 2, 4, 6, 8, ?</p>
      <input type="radio" name="q1" value="a"> 9<br>
      <input type="radio" name="q1" value="b"> 10<br>
      <input type="radio" name="q1" value="c"> 12<br>
    </div>

    <!-- Question 2 -->
    <div class="question">
      <p>2. Which shape does not belong?</p>
      <input type="radio" name="q2" value="a"> Circle<br>
      <input type="radio" name="q2" value="b"> Square<br>
      <input type="radio" name="q2" value="c"> Triangle<br>
      <input type="radio" name="q2" value="d"> Hexagon<br>
    </div>

    <!-- Question 3 -->
    <div class="question">
      <p>3. If all Bloops are Razzies and all Razzies are Lazzies, are all Bloops definitely Lazzies?</p>
      <input type="radio" name="q3" value="a"> Yes<br>
      <input type="radio" name="q3" value="b"> No<br>
    </div>

    <!-- Question 4 -->
    <div class="question">
      <p>4. What is the missing number?</p>
      <p>3, 6, 9, 12, ?</p>
      <input type="radio" name="q4" value="a"> 14<br>
      <input type="radio" name="q4" value="b"> 15<br>
      <input type="radio" name="q4" value="c"> 18<br>
    </div>

    <!-- Question 5 -->
    <div class="question">
      <p>5. Which word does not belong?</p>
      <input type="radio" name="q5" value="a"> Apple<br>
      <input type="radio" name="q5" value="b"> Banana<br>
      <input type="radio" name="q5" value="c"> Carrot<br>
      <input type="radio" name="q5" value="d"> Orange<br>
    </div>
  </div>
  <button onclick="calculateScore()">Submit</button>
  <div class="result" id="result"></div>

  <script>
    function calculateScore() {
      let score = 0;

      // Correct answers
      const answers = {
        q1: "b", // 10
        q2: "d", // Hexagon
        q3: "a", // Yes
        q4: "b", // 15
        q5: "c", // Carrot
      };

      // Check each question
      for (let i = 1; i <= 5; i++) {
        const questionName = `q${i}`;
        const selectedAnswer = document.querySelector(`input[name="${questionName}"]:checked`);

        if (selectedAnswer && selectedAnswer.value === answers[questionName]) {
          score++;
        }
      }

      // Display result
      const resultElement = document.getElementById("result");
      resultElement.textContent = `Your score is ${score} out of 5.`;

      // Optional: Calculate IQ-like score (for fun)
      const iqScore = (score / 5) * 100 + 60; // Arbitrary formula
      resultElement.textContent += ` (Approximate IQ: ${iqScore})`;
    }
  </script>
</body>
</html>
